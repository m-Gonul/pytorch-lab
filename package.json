{
  "name": "pytorch-lab",
  "version": "0.1.0",
  "description": "Elle → döngü → NumPy → PyTorch → vektörize: klasik ML'den ileri PyTorch'a, tarayıcıda çalışan Türkçe ders sitesi",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs dist",
    "notebooks": "node scripts/notebooks.mjs",
    "test": "node --test test/*.test.mjs",
    "test:py": "python test/test_modules.py && python test/test_notebooks.py"
  },
  "license": "MIT",
  "devDependencies": {
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
